{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "BUILD_TESTING": "ON",
        "MINI_OS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "host-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-release",
      "inherits": "host-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "host-sanitize",
      "inherits": "host-debug",
      "cacheVariables": { "MINI_OS_SANITIZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "host-sanitize", "configurePreset": "host-sanitize" }
  ],
  "testPresets": [
    { "name": "host-debug", "configurePreset": "host-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "host-release", "configurePreset": "host-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
