set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# Kernel tools are distinct from the Apple SDK compiler used for host tests.
find_program(MINI_OS_KERNEL_CLANG NAMES clang REQUIRED)
find_program(MINI_OS_KERNEL_CLANGXX NAMES clang++ REQUIRED)
find_program(MINI_OS_KERNEL_LLD NAMES ld.lld REQUIRED)
find_program(MINI_OS_KERNEL_AR NAMES llvm-ar REQUIRED)
find_program(MINI_OS_KERNEL_RANLIB NAMES llvm-ranlib REQUIRED)

set(CMAKE_C_COMPILER "${MINI_OS_KERNEL_CLANG}")
set(CMAKE_CXX_COMPILER "${MINI_OS_KERNEL_CLANGXX}")
set(CMAKE_ASM_COMPILER "${MINI_OS_KERNEL_CLANG}")
set(CMAKE_LINKER "${MINI_OS_KERNEL_LLD}")
set(CMAKE_AR "${MINI_OS_KERNEL_AR}")
set(CMAKE_RANLIB "${MINI_OS_KERNEL_RANLIB}")
set(CMAKE_C_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_CXX_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_ASM_FLAGS_INIT "--target=aarch64-none-elf")
